[user]
	name = Esteban Tejeda
	email = etejedaw@hotmail.com

[core]
	editor = nano

[http]
	lowSpeedLimit = 1000
	lowSpeedTime = 60
	postBuffer = 524288000

[credential "https://github.com"]
	helper = 
	helper = !gh auth git-credential
	
[credential "https://gist.github.com"]
	helper = 
	helper = !gh auth git-credential

# Config solo de este equipo (NO está en el repo). Va al final para pisar lo de arriba.
[include]
	path = ~/.gitconfig.local
