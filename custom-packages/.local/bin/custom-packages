#!/usr/bin/env bash
# Instala y actualiza los programas que se bajan de GitHub porque no están en dnf ni en Flathub (Fedora) o porque
# Homebrew no los deja instalar (Mac). Los gestores de paquetes no los ven: este script compara la versión instalada
# con la última release. Los comandos están en usage() (custom-packages --help).
#
# update e install dejan lo que muestran, sin colores, en ~/.local/state/dotfiles/custom-packages.log (solo la última
# ejecución).

# shellcheck disable=SC2034  # las variables <programa>_* se leen con ${!var}
set -euo pipefail

# Los arreglos asociativos piden bash 4 o más; el /bin/bash de Mac es 3.2 (el nuevo viene de brew)
(( BASH_VERSINFO[0] >= 4 )) || { echo "custom-packages necesita bash 4 o más (en Mac: brew install bash)." >&2; exit 1; }

BIN="$HOME/.local/bin"
LOG="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles/custom-packages.log"
readonly BIN LOG
if [[ $(uname) == Darwin ]]; then
  PKGS=(marktext)
else
  PKGS=(affine gitflow etcher vicinae)  # en GNOME se agrega vicinaegnome, la extensión de Vicinae
fi

# --- Programas ---
# Cada uno define: nombre, repo de GitHub, regex del archivo de la release, versión instalada
# (vacía si no está) e instalación a partir del archivo descargado ($1)

affine_name=AFFiNE
affine_repo=toeverything/AFFiNE
affine_asset='linux-x64\.flatpak$'
affine_version() {
  local dir
  dir=$(flatpak info --show-location pro.affine.app 2>/dev/null) || return 0
  # Un .flatpak suelto no guarda su versión en flatpak: se lee del metainfo de la app ("?" si no se encuentra)
  grep -om1 '<release version="[^"]*"' "$dir/files/lib/pro.affine.app/resources/affine.metainfo.xml" 2>/dev/null | cut -d'"' -f2 | grep . || echo '?'
}
# --reinstall porque un .flatpak no se puede instalar sobre otra versión; los datos en ~/.var/app se conservan
affine_install() { flatpak install --user -y --noninteractive --reinstall "$1"; }

gitflow_name=git-flow-next
gitflow_repo=gittower/git-flow-next
case "$(uname -m)" in
  aarch64) gitflow_asset='linux-arm64\.tar\.gz$' ;;
  *) gitflow_asset='linux-amd64\.tar\.gz$' ;;
esac
gitflow_version() {
  [[ -x $BIN/git-flow ]] || return 0
  "$BIN/git-flow" version 2>/dev/null | awk '{print $1}' | grep . || echo '?'
}
gitflow_install() { mkdir -p "$BIN" && tar -xzf "$1" -C "$BIN" git-flow; }

etcher_name=balenaEtcher
etcher_repo=balena-io/etcher
etcher_asset='x86_64\.rpm$'
etcher_version() {
  rpm -q balena-etcher >/dev/null 2>&1 || return 0
  rpm -q --qf '%{VERSION}' balena-etcher
}
etcher_install() { sudo dnf install -y "$1"; }

vicinae_name=Vicinae
vicinae_repo=vicinaehq/vicinae
case "$(uname -m)" in
  aarch64) vicinae_asset='aarch64\.AppImage$' ;;
  *) vicinae_asset='x86_64\.AppImage$' ;;
esac
vicinae_version() {
  [[ -x /usr/local/bin/vicinae ]] || return 0
  /usr/local/bin/vicinae version 2>/dev/null | awk '/^Version/ {sub(/^v/, "", $2); print $2}' | grep . || echo '?'
}
# Lo instala el script oficial a partir del AppImage descargado, en /usr/local (por eso sudo)
vicinae_install() {
  local script
  script="$(dirname "$1")/vicinae-install.sh"
  curl -fsSL https://vicinae.com/install -o "$script" && sudo bash "$script" --appimage "$1"
}

# Solo en GNOME. install.sh la activa; hace falta cerrar sesión y volver a entrar para que GNOME la cargue.
vicinaegnome_name=vicinae-gnome
vicinaegnome_repo=vicinaehq/gnome-extension
vicinaegnome_asset='shell-extension.*\.zip$'
vicinaegnome_version() {
  local meta="$HOME/.local/share/gnome-shell/extensions/vicinae@dagimg-dot/metadata.json"
  [[ -f $meta ]] || return 0
  jq -r '."version-name" // empty' "$meta" | grep . || echo '?'
}
vicinaegnome_install() { gnome-extensions install --force "$1"; }
command -v gnome-shell >/dev/null && PKGS+=(vicinaegnome)

# Solo en Mac: Homebrew desactivó su cask porque no pasa Gatekeeper (la app tiene firma ad-hoc, sin notarizar).
# Bajada con curl no queda en cuarentena, así que abre sin el aviso de Gatekeeper.
marktext_name=MarkText
marktext_repo=marktext/marktext
case "$(uname -m)" in
  arm64) marktext_asset='mac-arm64-.*\.zip$' ;;
  *) marktext_asset='mac-x64-.*\.zip$' ;;
esac
readonly MARKTEXT_APP=/Applications/marktext.app
marktext_version() {
  [[ -d $MARKTEXT_APP ]] || return 0
  plutil -extract CFBundleShortVersionString raw "$MARKTEXT_APP/Contents/Info.plist" 2>/dev/null || echo '?'
}
# Se descomprime aparte y reemplaza la app entera, para no mezclar archivos de dos versiones
marktext_install() {
  local dir
  dir="$(dirname "$1")/marktext"
  ditto -x -k "$1" "$dir" && rm -rf "$MARKTEXT_APP" && mv "$dir/marktext.app" "$MARKTEXT_APP"
}

# --- Utilidades ---

step() { printf '\n\033[1;34m==> %s\033[0m\n' "$*"; }
info() { printf '    %s\n' "$*"; }
warn() { printf '\033[1;33m    ! %s\033[0m\n' "$*" >&2; }

# Token para la API de GitHub: GITHUB_TOKEN o, si no está, el de gh. Con token GitHub permite 5000 consultas por hora;
# sin él, 60 por IP, y cada fetch gasta una por programa
github_token() {
  if [[ -n ${GITHUB_TOKEN:-} ]]; then
    printf '%s' "$GITHUB_TOKEN"
  elif command -v gh >/dev/null; then
    gh auth token 2>/dev/null || true
  fi
}

# Consulta la API de GitHub y escribe la respuesta. $1 = ruta (repos/…), $2 = token (vacío si no hay).
# El token va en un archivo de cabeceras (-H @…) y no como argumento, para que no aparezca en la lista de procesos.
# Devuelve 1 si la consulta falla y 2 si se agotó el límite de consultas.
github_api() {
  local path=$1 token=$2 response code
  response=$(curl -sSL -H @<(if [[ -n $token ]]; then printf 'Authorization: Bearer %s\n' "$token"; fi) \
    -w '\n%{http_code}' "https://api.github.com/$path") || return 1
  code=${response##*$'\n'}
  response=${response%$'\n'*}
  case $code in
    200) printf '%s\n' "$response" ;;
    403|429) if [[ $response == *'rate limit'* ]]; then return 2; else return 1; fi ;;
    *) return 1 ;;
  esac
}

# Consulta la última release de cada programa y deja su versión instalada y la última en INSTALLED/LATEST/URL
declare -A INSTALLED LATEST URL
fetch() {
  local p repo asset json token status=0 reset
  token=$(github_token)
  for p in "${PKGS[@]}"; do
    repo=${p}_repo asset=${p}_asset
    INSTALLED[$p]=$("${p}_version")
    LATEST[$p]='' URL[$p]=''
    # Con el límite agotado, las demás consultas también fallarían: se muestra solo lo instalado
    (( status == 2 )) && continue
    json=$(github_api "repos/${!repo}/releases/latest" "$token") && status=0 || status=$?
    case $status in
      0) ;;
      2)
        # Consultar el límite no gasta consultas
        reset=$(github_api rate_limit "$token" | jq -r '.resources.core.reset | strflocaltime("%H:%M")') || reset='?'
        warn "se agotó el límite de consultas a la API de GitHub; se renueva a las $reset"
        [[ -n $token ]] || warn "sin token son 60 por hora: con \`gh auth login\` o GITHUB_TOKEN son 5000"
        continue
        ;;
      *) warn "no se pudo consultar ${!repo} en GitHub"; continue ;;
    esac
    LATEST[$p]=$(jq -r '.tag_name | ltrimstr("v")' <<<"$json")
    URL[$p]=$(jq -r --arg re "${!asset}" '[.assets[] | select(.name | test($re)) | .browser_download_url][0] // ""' <<<"$json")
  done
}

# Verdadero si la última versión es más nueva que la instalada (una versión ilegible, "?", se trata como vieja)
newer() {
  local installed=${INSTALLED[$1]} latest=${LATEST[$1]}
  [[ -n $latest && $installed != "$latest" ]] || return 1
  [[ $installed == '?' ]] && return 0
  [[ $(printf '%s\n' "$installed" "$latest" | sort -V | tail -1) == "$latest" ]]
}

# Filtros de update e install
outdated() { [[ -n ${INSTALLED[$1]} ]] && newer "$1"; }
missing() { [[ -z ${INSTALLED[$1]} ]]; }

# Pide confirmación salvo con -y
confirm() {
  [[ $YES == yes ]] && return 0
  local answer
  read -rp "    ¿$1? [s/N] " answer
  [[ $answer == [sSyY]* ]]
}

# Descarga el archivo de la release de cada programa y lo instala
TMP=
apply() {
  local p name file failed=0
  TMP=$(mktemp -d)
  for p in "$@"; do
    name=${p}_name
    step "${!name} ${LATEST[$p]}"
    if [[ -z ${URL[$p]} ]]; then
      warn "la release no tiene un archivo que coincida"; failed=1; continue
    fi
    file="$TMP/$(basename "${URL[$p]}")"
    if curl -fL --progress-bar "${URL[$p]}" -o "$file" && "${p}_install" "$file"; then
      info "listo"
    else
      warn "falló la instalación de ${!name}"; failed=1
    fi
  done
  return $failed
}

# Lo común de update e install: elige los programas que pasan el filtro, los muestra, pide confirmación y los instala.
# $1 = filtro (outdated o missing), $2 = mensaje si no hay ninguno, $3 = título de la lista, $4 = pregunta
select_and_apply() {
  local filter=$1 none=$2 title=$3 question=$4 p name todo=()
  fetch
  for p in "${PKGS[@]}"; do
    "$filter" "$p" && todo+=("$p")
  done
  if (( ! ${#todo[@]} )); then
    info "$none"; return 0
  fi
  step "$title"
  for p in "${todo[@]}"; do
    name=${p}_name
    if [[ -n ${INSTALLED[$p]} ]]; then
      info "${!name}: ${INSTALLED[$p]} → ${LATEST[$p]}"
    else
      info "${!name} ${LATEST[$p]}"
    fi
  done
  confirm "$question" || return 0
  apply "${todo[@]}"
}

usage() {
  cat <<'EOF'
  custom-packages ls            lista la versión instalada y la última de cada uno, sin cambiar nada
  custom-packages update [-y]   actualiza los instalados que tienen versión nueva (-y: sin preguntar)
  custom-packages install [-y]  instala los que faltan
EOF
  exit "${1:-0}"
}

# Al salir: borra las descargas y, si algo falló, dice dónde está el log
LOGGING=no
on_exit() {
  local code=$?
  if [[ -n $TMP ]]; then rm -rf "$TMP"; fi
  if (( code )) && [[ $LOGGING == yes ]]; then warn "custom-packages terminó con error (código $code). Log: ${LOG/#$HOME/\~}"; fi
}
trap on_exit EXIT

# --- Comandos ---

ARGS="$*"
CMD=${1:-}
[[ $# -gt 0 ]] && shift
YES=no
for arg; do
  case "$arg" in
    -y|--yes) YES=yes ;;
    *) echo "Opción desconocida: $arg" >&2; usage 1 ;;
  esac
done

# update e install dejan un log igual que install.sh: la salida va también al archivo, sin colores, y la trampa ERR
# anota el comando que falló y su línea. ls no, para no pisar el log de la última instalación.
if [[ $CMD == update || $CMD == install ]]; then
  mkdir -p "$(dirname "$LOG")"
  printf '== custom-packages %s · %s\n' "$ARGS" "$(date '+%Y-%m-%d %H:%M:%S')" >"$LOG"
  exec > >(tee >(sed $'s/\e\\[[0-9;]*m//g' >>"$LOG")) 2>&1
  LOGGING=yes
  set -E
  trap 'warn "falló en la línea $LINENO: $BASH_COMMAND"' ERR
fi

case "$CMD" in
  ls)
    fetch
    printf '\n    %-15s %-12s %s\n' PROGRAMA INSTALADA ÚLTIMA
    for p in "${PKGS[@]}"; do
      name=${p}_name
      printf '    %-15s %-12s %s' "${!name}" "${INSTALLED[$p]:-—}" "${LATEST[$p]:-?}"
      if [[ -z ${INSTALLED[$p]} ]]; then printf '  (no instalado)'
      elif newer "$p"; then printf '  (hay actualización)'
      fi
      echo
    done
    ;;
  update) select_and_apply outdated "todo al día" "Actualizaciones disponibles" "Actualizar" ;;
  install) select_and_apply missing "todo instalado" "Por instalar" "Instalar" ;;
  -h|--help|help) usage ;;
  *) usage 1 ;;
esac
