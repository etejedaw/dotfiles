IgnoreUnknown UseKeychain
Include ~/.ssh/config.d/*

Host home-server
	User esteban
	IdentityFile ~/.ssh/home-server

Host home-workstation
	User esteban
	IdentityFile ~/.ssh/home-workstation

Host vps-esteban
	User esteban
	IdentityFile ~/.ssh/vps-esteban

Host vps-prici
	User esteban
	IdentityFile ~/.ssh/vps-prici

Host github.com
	IdentityFile ~/.ssh/id_ed25519

Host *
	IdentitiesOnly yes
	AddKeysToAgent yes
	UseKeychain yes
